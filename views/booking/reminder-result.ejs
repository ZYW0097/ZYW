<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>訂位確認 - DINE✦</title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- 全局樣式 -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/main.css">
    <!-- 頁面專用CSS -->
    <link rel="stylesheet" href="/css/reminder-result.css">
</head>
<body>
    <div class="reminder-result-wrapper">
        <div class="reminder-result-container">
            <div class="result-icon">
                <% if (success) { %>
                    <% if (type === 'confirm') { %>
                        <div class="icon success-icon">✓</div>
                    <% } else { %>
                        <div class="icon cancel-icon">✗</div>
                    <% } %>
                <% } else { %>
                    <div class="icon error-icon">!</div>
                <% } %>
            </div>
            
            <div class="result-message">
                <h2><%= message %></h2>
            </div>
            
            <% if (success && bookingInfo) { %>
                <div class="booking-summary">
                    <h3>訂位資訊</h3>
                    <div class="info-grid">
                        <div class="info-item">
                            <span class="label">訂位編號：</span>
                            <span class="value booking-id"><%= bookingInfo.customBookingId %></span>
                        </div>
                        <div class="info-item">
                            <span class="label">用餐日期：</span>
                            <span class="value"><%= bookingInfo.date %></span>
                        </div>
                        <div class="info-item">
                            <span class="label">用餐時間：</span>
                            <span class="value"><%= bookingInfo.time %></span>
                        </div>
                        <div class="info-item">
                            <span class="label">用餐人數：</span>
                            <span class="value"><%= bookingInfo.adults %>大 <%= bookingInfo.children %>小</span>
                        </div>
                        <% if (type === 'confirm') { %>
                            <div class="info-item">
                                <span class="label">狀態：</span>
                                <span class="value status-confirmed">已確認</span>
                            </div>
                        <% } else if (type === 'cancel') { %>
                            <div class="info-item">
                                <span class="label">狀態：</span>
                                <span class="value status-cancelled">已取消</span>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% } %>
            
            <div class="result-actions">
                <% if (type === 'confirm' && success) { %>
                    <p class="note">我們期待您的光臨！如有任何需要協助的地方，請隨時聯絡我們。</p>
                <% } else if (type === 'cancel' && success) { %>
                    <p class="note">感謝您提前告知。歡迎您日後再次預訂我們的餐廳。</p>
                <% } else if (!success) { %>
                    <div class="action-buttons">
                        <a href="/" class="btn btn-secondary">返回首頁</a>
                        <a href="javascript:history.back()" class="btn btn-primary">重新嘗試</a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html> 