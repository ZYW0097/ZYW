<div class="auth-container">
    <div class="auth-header">
        <h1 class="auth-title">忘記密碼</h1>
        <p class="auth-subtitle">請輸入您的手機號碼，我們將發送重設密碼的連結</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="error-message">
            <%= error %>
        </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="success-message">
            <%= success %>
        </div>
    <% } %>

    <!-- 忘記密碼表單 -->
    <form class="auth-form" action="/auth/forgot-password" method="POST" id="forgotForm">
        <div class="form-group">
            <label class="form-label" for="phone">手機號碼</label>
            <input 
                type="tel" 
                id="phone" 
                name="phone" 
                class="form-input" 
                placeholder="請輸入手機號碼（例：0912345678）"
                required
            >
        </div>

        <button type="submit" class="auth-btn auth-btn-primary" id="forgotBtn">
            發送重設連結
        </button>
    </form>

    <!-- 切換到登入 -->
    <div class="auth-switch">
        <p class="auth-switch-text">想起密碼了嗎？</p>
        <a href="/auth/login" class="auth-switch-link">返回登入</a>
    </div>
</div>

<link rel="stylesheet" href="/css/auth.css">
<script>
document.addEventListener('DOMContentLoaded', function() {
    const forgotForm = document.getElementById('forgotForm');
    const forgotBtn = document.getElementById('forgotBtn');
    const phoneInput = document.getElementById('phone');

    // 電話號碼格式化
    phoneInput.addEventListener('input', function() {
        let value = this.value.replace(/\D/g, '');
        if (value.length > 10) {
            value = value.substring(0, 10);
        }
        this.value = value;
        
        // 驗證格式
        if (value.length === 10 && value.startsWith('09')) {
            this.classList.remove('error');
        } else if (value.length > 0) {
            this.classList.add('error');
        }
    });

    // 表單提交
    forgotForm.addEventListener('submit', function(e) {
        const phone = phoneInput.value;

        // 驗證電話號碼格式
        if (!/^09\d{8}$/.test(phone)) {
            e.preventDefault();
            phoneInput.classList.add('error');
            alert('請輸入正確的手機號碼格式（例：0912345678）');
            return;
        }

        // 顯示載入狀態
        forgotBtn.classList.add('btn-loading');
        forgotBtn.disabled = true;
        forgotBtn.textContent = '發送中...';
    });

    // 移除錯誤狀態
    phoneInput.addEventListener('focus', function() {
        this.classList.remove('error');
    });
});
</script> 