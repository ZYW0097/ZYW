<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="store-slug" content="<%= storeSlug %>">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <title>商家控制台 - <%= clientname %></title>
    <link rel="stylesheet" href="/css/backstage-spa.css">
</head>
<body>
    <div class="backstage-spa-container">
        <!-- 行動版選單按鈕 -->
        <button class="backstage-mobile-toggle" id="backstage-mobile-toggle">☰</button>
        <div class="backstage-mobile-overlay" id="backstage-mobile-overlay"></div>

        <!-- 主要內容包裝器 -->
        <div class="backstage-content-wrapper">
            <!-- 側邊欄 -->
            <div class="backstage-sidebar">
                <!-- 側邊欄標題 -->
                <div class="backstage-sidebar-header">
                    <div class="backstage-logo">
                        <h2>商家控制台</h2>
                    </div>
                </div>
                
                <!-- 導航選單 -->
                <nav class="backstage-nav">
                    <ul class="backstage-nav-list">
                        <li class="backstage-nav-item">
                            <a href="#dashboard" class="backstage-nav-link active" data-page="dashboard">
                                <span class="nav-text">控制台首頁</span>
                            </a>
                        </li>
                        <li class="backstage-nav-item">
                            <a href="#basic" class="backstage-nav-link" data-page="basic">
                                <span class="nav-text">基本設定</span>
                            </a>
                        </li>
                        <li class="backstage-nav-item">
                            <a href="#booking" class="backstage-nav-link" data-page="booking">
                                <span class="nav-text">訂位設定</span>
                            </a>
                        </li>
                        <li class="backstage-nav-item">
                            <a href="#points" class="backstage-nav-link" data-page="points">
                                <span class="nav-text">集點卡設定</span>
                            </a>
                        </li>
                        <li class="backstage-nav-item">
                            <a href="#qrcode" class="backstage-nav-link" data-page="qrcode">
                                <span class="nav-text">點數QR碼</span>
                            </a>
                        </li>
                    </ul>
                </nav>
                
                <div class="backstage-sidebar-footer">
                    <a href="/<%= storeSlug %>" class="backstage-footer-link">
                        <span class="nav-text">查看餐廳</span>
                    </a>
                    <a href="/<%= storeSlug %>/backstage/logout" class="backstage-footer-link logout">
                        <span class="nav-text">登出</span>
                    </a>
                </div>
            </div>

            <!-- 主要內容區域 -->
            <div class="backstage-main-content">
                <!-- 控制台首頁 -->
                <div class="backstage-page active" id="dashboard-page">
                    <div class="backstage-page-header">
                        <h1>控制台首頁</h1>
                        <p>歡迎回到商家管理中心</p>
                    </div>
                    
                    <!-- 系統狀態卡片 -->
                    <div class="backstage-dashboard-grid">
                        <div class="backstage-status-card">
                            <div class="status-card-icon">📊</div>
                            <div class="status-card-content">
                                <h3>系統狀態</h3>
                                <p class="status-value">正常運行</p>
                                <span class="status-time">即時監控</span>
                            </div>
                        </div>
                        
                        <div class="backstage-status-card">
                            <div class="status-card-icon">📅</div>
                            <div class="status-card-content">
                                <h3>建立時間</h3>
                                <p class="status-value"><%= createdAt ? new Date(createdAt).toLocaleDateString('zh-TW') : '未知' %></p>
                                <span class="status-time">餐廳成立日期</span>
                            </div>
                        </div>
                        
                        <div class="backstage-status-card">
                            <div class="status-card-icon">🔄</div>
                            <div class="status-card-content">
                                <h3>最後更新</h3>
                                <p class="status-value"><%= updatedAt ? new Date(updatedAt).toLocaleDateString('zh-TW') : '未知' %></p>
                                <span class="status-time">資料更新時間</span>
                            </div>
                        </div>
                        
                        <div class="backstage-status-card">
                            <div class="status-card-icon">🔗</div>
                            <div class="status-card-content">
                                <h3>餐廳網址</h3>
                                <p class="status-value">/<%= storeSlug %></p>
                                <span class="status-time">客戶訪問連結</span>
            </div>
        </div>
    </div>

                    <!-- 快捷操作 -->
                    <div class="backstage-quick-actions">
                        <h2>快捷操作</h2>
                        <div class="quick-actions-grid">
                            <button class="quick-action-btn" onclick="navigateToPage('basic')">
                                <span class="action-icon">⚙️</span>
                                <span class="action-text">基本設定</span>
                            </button>
                            <button class="quick-action-btn" onclick="navigateToPage('booking')">
                                <span class="action-icon">📅</span>
                                <span class="action-text">訂位設定</span>
                            </button>
                            <button class="quick-action-btn" onclick="navigateToPage('points')">
                                <span class="action-icon">🎯</span>
                                <span class="action-text">集點卡設定</span>
                            </button>
                            <button class="quick-action-btn" onclick="navigateToPage('qrcode')">
                                <span class="action-icon">📱</span>
                                <span class="action-text">點數QR碼</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 基本設定頁面 -->
                <div class="backstage-page" id="basic-page">
                    <div class="backstage-page-header">
                        <button class="backstage-back-btn" onclick="navigateToPage('dashboard')">← 返回</button>
                        <h1>基本設定</h1>
                        <p>管理餐廳基本資訊和系統設定</p>
                    </div>
                    
                    <div class="backstage-page-content">
                        <form id="basicInfoForm" class="backstage-form">
                            <div class="backstage-form-section">
                                <h3>餐廳資訊</h3>
                                <div class="backstage-form-row">
                                    <div class="backstage-form-group">
                <label for="clientname">餐廳名稱</label>
                                        <input type="text" id="clientname" name="clientname" 
                                               value="<%= clientname || '' %>" 
                                               required maxlength="30" placeholder="請輸入餐廳名稱">
            </div>
                                    <div class="backstage-form-group">
                <label for="restaurantAddress">餐廳地址</label>
                                        <input type="text" id="restaurantAddress" name="restaurantAddress" 
                                               value="<%= (customSettings && customSettings.restaurantAddress) ? customSettings.restaurantAddress : '' %>" 
                                               placeholder="請輸入餐廳完整地址">
                                    </div>
            </div>
    </div>

                            <div class="backstage-form-section">
                                <h3>功能設定</h3>
                                <div class="backstage-form-row">
                                    <div class="backstage-form-group">
                                        <label class="backstage-toggle-label">
                                            <input type="checkbox" id="pointsSystemToggle" 
                                                   <%= (customSettings && customSettings.features && customSettings.features.pointsSystem) ? 'checked' : '' %>>
                                            <span class="backstage-toggle-slider"></span>
                                            <span class="backstage-toggle-text">集點卡系統</span>
                </label>
                                        <small>開啟或關閉集點卡功能</small>
                                    </div>
                                    <div class="backstage-form-group">
                                        <label class="backstage-toggle-label">
                                            <input type="checkbox" id="bookingSystemToggle" 
                                                   <%= (customSettings && customSettings.features && customSettings.features.bookingSystem) ? 'checked' : '' %>>
                                            <span class="backstage-toggle-slider"></span>
                                            <span class="backstage-toggle-text">訂位系統</span>
                </label>
                                        <small>開啟或關閉訂位功能</small>
                                    </div>
                                </div>
                                <div class="backstage-form-actions">
                                    <button type="button" class="backstage-btn backstage-btn-primary" onclick="updateFeatureSettings()">更新功能設定</button>
            </div>
    </div>

                            <div class="backstage-form-section">
                                <h3>安全設定</h3>
                                <div class="backstage-form-row">
                                    <div class="backstage-form-group">
                                        <label for="adminPassword">新管理員密碼</label>
                                        <input type="password" id="adminPassword" name="adminPassword" 
                                               placeholder="留空則不更改密碼">
                                        <small>密碼至少8個字元，包含大小寫字母、數字和特殊字元</small>
                                    </div>
                                </div>
                            </div>

                            <div class="backstage-form-actions">
                                <button type="submit" class="backstage-btn backstage-btn-primary">儲存設定</button>
                            </div>
                        </form>

                        <!-- 危險操作區域 -->
                        <div class="backstage-danger-zone">
                            <h3>危險操作</h3>
                            <p>以下操作將永久刪除所有數據，無法復原</p>
                            <button type="button" class="backstage-btn backstage-btn-danger" onclick="confirmDeleteStore()">
                                刪除餐廳
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 訂位設定頁面 -->
                <div class="backstage-page" id="booking-page">
                    <div class="backstage-page-header">
                        <button class="backstage-back-btn" onclick="navigateToPage('dashboard')">← 返回</button>
                        <h1>訂位設定</h1>
                        <p>管理餐廳圖片、訂位時段和用餐規則</p>
                    </div>
                    
                    <div class="backstage-page-content">
                        <% if (customSettings && customSettings.features && customSettings.features.bookingSystem) { %>
                        <!-- 餐廳圖片設定 -->
                        <div class="backstage-setting-card">
                            <h3>餐廳圖片</h3>
                            <form id="restaurantImageForm" class="backstage-form" enctype="multipart/form-data">
                                <div class="backstage-image-upload">
                                    <div class="backstage-image-preview">
                                        <img src="<%= (customSettings && customSettings.restaurantImage) ? customSettings.restaurantImage : '/images/dine.jpg' %>" 
                                             alt="餐廳圖片" id="restaurantImagePreview">
                                    </div>
                                    <div class="backstage-image-controls">
                                        <input type="file" name="restaurantImage" id="restaurantImageInput" accept=".png,.jpg,.jpeg,.svg" style="display: none;">
                                        <button type="button" class="backstage-btn backstage-btn-outline" onclick="document.getElementById('restaurantImageInput').click()">
                                            選擇圖片
                                        </button>
                                        <button type="submit" class="backstage-btn backstage-btn-primary">更新圖片</button>
                                    </div>
                                </div>
                            </form>
                        </div>

                        <!-- 訂位基本設定 -->
                        <div class="backstage-setting-card">
                            <h3>訂位基本設定</h3>
                            <p class="backstage-card-desc">設定訂位的人數限制和餐廳特色選項</p>
                            
                            <form id="bookingBasicSettingsForm" class="backstage-form">
                                <!-- 人數限制設定 -->
                                <div class="backstage-form-section">
                                    <h4>人數限制設定</h4>
                                    <div class="backstage-form-row">
                                        <div class="backstage-form-group">
                                            <label for="maxAdults">大人最多人數</label>
                                            <input type="number" id="maxAdults" name="maxAdults" 
                                                   value="<%= (customSettings && customSettings.bookingSettings && customSettings.bookingSettings.maxAdults) ? customSettings.bookingSettings.maxAdults : '6' %>" 
                                                   min="1" max="20" required>
                                            <small>單次訂位大人的最多人數（1-20人）</small>
                                        </div>
                                        <div class="backstage-form-group">
                                            <label for="maxChildren">小孩最多人數</label>
                                            <input type="number" id="maxChildren" name="maxChildren" 
                                                   value="<%= (customSettings && customSettings.bookingSettings && customSettings.bookingSettings.maxChildren) ? customSettings.bookingSettings.maxChildren : '6' %>" 
                                                   min="0" max="20" required>
                                            <small>單次訂位小孩的最多人數（0-20人）</small>
                                        </div>
                                    </div>
                                    <div class="backstage-form-row">
                                        <div class="backstage-form-group">
                                            <label for="maxTotalPeople">總人數上限</label>
                                            <input type="number" id="maxTotalPeople" name="maxTotalPeople" 
                                                   value="<%= (customSettings && customSettings.bookingSettings && customSettings.bookingSettings.maxTotalPeople) ? customSettings.bookingSettings.maxTotalPeople : '10' %>" 
                                                   min="1" max="30" required>
                                            <small>單次訂位的總人數上限（大人+小孩，1-30人）</small>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- 餐廳特色選項設定 -->
                                <div class="backstage-form-section">
                                    <h4>餐廳特色選項</h4>
                                    <div class="backstage-form-row">
                                        <div class="backstage-form-group">
                                            <label class="backstage-toggle-label">
                                                <input type="checkbox" id="enableVegetarian" name="enableVegetarian" 
                                                       <%= (customSettings && customSettings.bookingSettings && customSettings.bookingSettings.enableVegetarian) ? 'checked' : '' %>>
                                                <span class="backstage-toggle-slider"></span>
                                                <span class="backstage-toggle-text">提供素食選項</span>
                                            </label>
                                            <small>開啟此選項讓顧客可選擇素食需求</small>
                                        </div>
                                        <div class="backstage-form-group">
                                            <label class="backstage-toggle-label">
                                                <input type="checkbox" id="enableSpecialRequests" name="enableSpecialRequests" 
                                                       <%= (customSettings && customSettings.bookingSettings && customSettings.bookingSettings.enableSpecialRequests) ? 'checked' : '' %>>
                                                <span class="backstage-toggle-slider"></span>
                                                <span class="backstage-toggle-text">接受特殊需求</span>
                                            </label>
                                            <small>開啟此選項讓顧客可填寫特殊需求（如過敏、行動不便等）</small>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- 特殊需求選項設定 -->
                                <div class="backstage-form-section" id="specialRequestsOptions">
                                    <h4>特殊需求選項設定</h4>
                                    <div class="backstage-form-row">
                                        <div class="backstage-form-group">
                                            <label>
                                                <input type="radio" name="specialRequestsType" value="default" 
                                                       <%= (!customSettings || !customSettings.bookingSettings || !customSettings.bookingSettings.specialRequestsType || customSettings.bookingSettings.specialRequestsType === 'default') ? 'checked' : '' %>>
                                                使用預設範本
                                            </label>
                                            <small>使用系統預設的特殊需求選項</small>
                                        </div>
                                        <div class="backstage-form-group">
                                            <label>
                                                <input type="radio" name="specialRequestsType" value="custom" 
                                                       <%= (customSettings && customSettings.bookingSettings && customSettings.bookingSettings.specialRequestsType === 'custom') ? 'checked' : '' %>>
                                                自訂選項
                                            </label>
                                            <small>完全自訂特殊需求選項</small>
                                        </div>
                                    </div>
                                    
                                    <!-- 自訂特殊需求選項列表 -->
                                    <div id="customSpecialRequestsList" class="backstage-dynamic-list" style="display: none;">
                                        <h5>自訂特殊需求選項</h5>
                                        <div id="specialRequests-list">
                                            <% if (customSettings && customSettings.bookingSettings && customSettings.bookingSettings.customSpecialRequests && customSettings.bookingSettings.customSpecialRequests.length > 0) { %>
                                                <% customSettings.bookingSettings.customSpecialRequests.forEach((option, index) => { %>
                                                <div class="backstage-list-item">
                                                    <input type="text" name="customSpecialRequests[]" value="<%= option %>" placeholder="請輸入特殊需求選項">
                                                    <% if (index === customSettings.bookingSettings.customSpecialRequests.length - 1) { %>
                                                        <button type="button" class="backstage-btn-icon backstage-btn-add" onclick="addSpecialRequest()">+</button>
                                                    <% } %>
                                                    <% if (customSettings.bookingSettings.customSpecialRequests.length > 1) { %>
                                                        <button type="button" class="backstage-btn-icon backstage-btn-remove" onclick="removeSpecialRequest(this)">×</button>
                                                    <% } %>
                                                </div>
                                                <% }) %>
                                            <% } else { %>
                                                <div class="backstage-list-item">
                                                    <input type="text" name="customSpecialRequests[]" placeholder="請輸入特殊需求選項">
                                                    <button type="button" class="backstage-btn-icon backstage-btn-add" onclick="addSpecialRequest()">+</button>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="backstage-form-actions">
                                    <button type="submit" class="backstage-btn backstage-btn-primary">儲存基本設定</button>
                                </div>
                            </form>
                        </div>

                        <!-- 訂位時段設定 -->
                        <div class="backstage-setting-card">
                            <h3>訂位時段管理</h3>
                            <p class="backstage-card-desc">設定餐廳的訂位時段，並管理每個時段的開放狀態和訂位上限</p>
                            
                            <!-- 新增時段 -->
                            <div class="backstage-add-timeslot-section">
                                <h4>新增時段</h4>
                                <form id="addTimeSlotForm" class="backstage-form">
                                    <div class="backstage-form-row">
                                        <div class="backstage-form-group">
                                            <label for="newTimeSlot">時段時間</label>
                                            <input type="time" id="newTimeSlot" name="newTimeSlot" required>
                                        </div>
                                        <div class="backstage-form-group">
                                            <label for="newMaxBookings">最多訂位組數</label>
                                            <input type="number" id="newMaxBookings" name="newMaxBookings" 
                                                   min="1" max="50" value="10" required>
                                        </div>
                                        <div class="backstage-form-group">
                                            <button type="submit" class="backstage-btn backstage-btn-primary">新增時段</button>
                                        </div>
                                    </div>
                                </form>
                            </div>

                            <!-- 現有時段管理 -->
                            <div class="backstage-timeslots-management">
                                <h4>時段管理</h4>
                                <div class="backstage-timeslots-header">
                                    <button type="button" class="backstage-btn backstage-btn-outline" onclick="toggleAllTimeSlots(true)">
                                        全部開啟
                                    </button>
                                    <button type="button" class="backstage-btn backstage-btn-outline" onclick="toggleAllTimeSlots(false)">
                                        全部關閉
                                    </button>
                                    <button type="button" class="backstage-btn backstage-btn-secondary" onclick="loadTimeSlots()">
                                        🔄 重新整理
                                    </button>
                                </div>
                                
                                <div id="timeSlots-grid" class="backstage-timeslots-grid">
                                    <div class="loading-timeslots">
                                        <p>🔄 正在載入時段設定...</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 用餐規則設定 -->
                        <div class="backstage-setting-card">
                            <h3>用餐規則</h3>
                            <form id="diningRulesForm" class="backstage-form">
                                <div id="diningRules-list" class="backstage-dynamic-list">
                                    <% if (customSettings && customSettings.diningRules && customSettings.diningRules.length > 0) { %>
                                        <% customSettings.diningRules.forEach((rule, index) => { %>
                                        <div class="backstage-list-item">
                                            <input type="text" name="diningRules[]" value="<%= rule.text %>" required placeholder="請輸入用餐規則">
                                            <% if (index === customSettings.diningRules.length - 1) { %>
                                                <button type="button" class="backstage-btn-icon backstage-btn-add" onclick="addDiningRule()">+</button>
                                            <% } %>
                                            <% if (customSettings.diningRules.length > 1) { %>
                                                <button type="button" class="backstage-btn-icon backstage-btn-remove" onclick="removeDiningRule(this)">×</button>
                                            <% } %>
                                        </div>
                                        <% }) %>
                                    <% } else { %>
                                        <div class="backstage-list-item">
                                            <input type="text" name="diningRules[]" placeholder="請輸入用餐規則" required>
                                            <button type="button" class="backstage-btn-icon backstage-btn-add" onclick="addDiningRule()">+</button>
                                        </div>
                                    <% } %>
                                </div>
                                <div class="backstage-form-actions">
                                    <button type="submit" class="backstage-btn backstage-btn-primary">儲存規則設定</button>
                                </div>
                            </form>
                        </div>
                        <% } else { %>
                        <!-- 訂位功能未開啟 -->
                        <div class="backstage-setting-card">
                            <h3>訂位功能未開啟</h3>
                            <div class="backstage-info-box">
                                <p>訂位功能目前未開啟。請到基本設定中開啟訂位系統。</p>
                                <button type="button" class="backstage-btn backstage-btn-primary" onclick="navigateToPage('basic')">
                                    前往開啟訂位功能
                                </button>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>

                <!-- 集點卡設定頁面 -->
                <div class="backstage-page" id="points-page">
                    <div class="backstage-page-header">
                        <button class="backstage-back-btn" onclick="navigateToPage('dashboard')">← 返回</button>
                        <h1>集點卡設定</h1>
                        <p>管理集點卡背景圖片、規則和獎勵</p>
                    </div>
                    
                    <div class="backstage-page-content">
                        <% if (customSettings && customSettings.features && customSettings.features.pointsSystem) { %>
                        <!-- 集點卡背景圖片 -->
                        <div class="backstage-setting-card">
                            <h3>集點卡背景圖片</h3>
                            <form id="cardImageForm" class="backstage-form" enctype="multipart/form-data">
                                <div class="backstage-image-upload">
                                    <div class="backstage-image-preview">
                                        <img src="<%= (customSettings && customSettings.cardBackgroundImage) ? customSettings.cardBackgroundImage : '/images/dine.jpg' %>" 
                                             alt="集點卡背景" id="cardImagePreview">
                                    </div>
                                    <div class="backstage-image-controls">
                                        <input type="file" name="cardBackgroundImage" id="cardImageInput" accept=".png,.jpg,.jpeg,.svg" style="display: none;">
                                        <button type="button" class="backstage-btn backstage-btn-outline" onclick="document.getElementById('cardImageInput').click()">
                                            選擇圖片
                                        </button>
                                        <button type="submit" class="backstage-btn backstage-btn-primary">更新圖片</button>
                                    </div>
                                </div>
                            </form>
                        </div>

                        <!-- 集點卡規則設定 -->
                        <div class="backstage-setting-card">
                            <h3>集點規則設定</h3>
                            <form id="pointsRulesForm" class="backstage-form">
                                <div class="backstage-form-row">
                                    <div class="backstage-form-group">
                                        <label for="welcomePoints">首次領取獎勵</label>
                                        <input type="number" id="welcomePoints" name="welcomePoints" 
                                               value="<%= (customSettings && customSettings.pointsRules && typeof customSettings.pointsRules.welcomePoints !== 'undefined') ? customSettings.pointsRules.welcomePoints : '0' %>" 
                                               min="0" max="50" required>
                                        <small>新用戶首次領取集點卡時獲得的點數（0-50點）</small>
                                    </div>
                                    <div class="backstage-form-group">
                                        <label for="maxPointsPerDay">每日點數上限</label>
                                        <input type="number" id="maxPointsPerDay" name="maxPointsPerDay" 
                                               value="<%= (customSettings && customSettings.pointsRules && typeof customSettings.pointsRules.maxPointsPerDay !== 'undefined') ? customSettings.pointsRules.maxPointsPerDay : '3' %>" 
                                               min="1" max="20" required>
                                        <small>每位顧客每天最多可獲得的點數</small>
                                    </div>
                                </div>
                                <div class="backstage-form-row">
                                    <div class="backstage-form-group">
                                        <label for="pointsExpireDays">點數有效期</label>
                                        <input type="number" id="pointsExpireDays" name="pointsExpireDays" 
                                               value="<%= (customSettings && customSettings.pointsRules && typeof customSettings.pointsRules.pointsExpireDays !== 'undefined') ? customSettings.pointsRules.pointsExpireDays : '365' %>" 
                                               min="30" max="1095" required>
                                        <small>點數的有效天數（30-1095天）</small>
                                    </div>
                                </div>
                                <div class="backstage-form-actions">
                                    <button type="submit" class="backstage-btn backstage-btn-primary">儲存規則設定</button>
                                </div>
                            </form>
                        </div>

                        <!-- 獎勵項目設定 -->
                        <div class="backstage-setting-card">
                            <h3>獎勵項目設定</h3>
                            <form id="rewardsForm" class="backstage-form" enctype="multipart/form-data">
                                <div id="rewards-list" class="backstage-rewards-list">
                                    <% if (customSettings && customSettings.rewards && customSettings.rewards.length > 0) { %>
                                        <% customSettings.rewards.forEach((reward, index) => { %>
                                        <div class="backstage-reward-item">
                                            <div class="reward-item-header">
                                                <h4>獎勵項目 <%= index + 1 %></h4>
                                                <% if (customSettings.rewards.length > 1) { %>
                                                    <button type="button" class="backstage-btn-icon backstage-btn-remove" onclick="removeReward(this)">×</button>
                                                <% } %>
                                            </div>
                                            <div class="backstage-form-row">
                                                <div class="backstage-form-group">
                                                    <label>獎勵名稱</label>
                                                    <input type="text" name="rewardName[]" value="<%= reward.name %>" required placeholder="例如：免費飲料">
                                                </div>
                                                <div class="backstage-form-group">
                                                    <label>所需點數</label>
                                                    <input type="number" name="rewardPoints[]" value="<%= reward.points %>" min="1" max="100" required placeholder="例如：10">
                                                </div>
                                                <div class="backstage-form-group backstage-toggle-group">
                                                    <label class="backstage-toggle-label">
                                                        <input type="checkbox" name="rewardActive[]" value="<%= index %>" <%= reward.active ? 'checked' : '' %>>
                                                        <span class="backstage-toggle-slider"></span>
                                                        <span class="backstage-toggle-text">啟用此獎勵</span>
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="backstage-form-row">
                                                <div class="backstage-form-group backstage-image-group">
                                                    <label>獎勵圖片</label>
                                                    <div class="backstage-file-upload-area" onclick="triggerFileUpload('<%= index %>')">
                                                        <input type="file" name="rewardImage[]" id="rewardImage-<%= index %>" accept=".png,.jpg,.jpeg" style="display: none;" onchange="handleRewardImageUpload(this, '<%= index %>')">
                                                        <% if (reward.img && reward.img !== '/images/coupon-default.svg') { %>
                                                            <img src="<%= reward.img %>" alt="獎勵圖片" class="backstage-reward-preview" id="preview-<%= index %>">
                                                            <div class="backstage-file-overlay">
                                                                <span>📷 更換圖片</span>
                                                            </div>
                                                        <% } else { %>
                                                            <div class="backstage-file-placeholder" id="placeholder-<%= index %>">
                                                                <span class="backstage-file-icon">📷</span>
                                                                <span class="backstage-file-text">點擊上傳獎勵圖片</span>
                                                                <small>支援 PNG、JPG、JPEG 格式</small>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <% }) %>
                                    <% } else { %>
                                    <div class="backstage-reward-item">
                                        <div class="reward-item-header">
                                            <h4>獎勵項目 1</h4>
                                        </div>
                                        <div class="backstage-form-row">
                                            <div class="backstage-form-group">
                                                <label>獎勵名稱</label>
                                                <input type="text" name="rewardName[]" required placeholder="例如：免費飲料">
                                            </div>
                                            <div class="backstage-form-group">
                                                <label>所需點數</label>
                                                <input type="number" name="rewardPoints[]" min="1" max="100" required placeholder="例如：10">
                                            </div>
                                            <div class="backstage-form-group backstage-toggle-group">
                                                <label class="backstage-toggle-label">
                                                    <input type="checkbox" name="rewardActive[]" value="0" checked>
                                                    <span class="backstage-toggle-slider"></span>
                                                    <span class="backstage-toggle-text">啟用此獎勵</span>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="backstage-form-row">
                                            <div class="backstage-form-group backstage-image-group">
                                                <label>獎勵圖片</label>
                                                <div class="backstage-file-upload-area" onclick="triggerFileUpload('0')">
                                                    <input type="file" name="rewardImage[]" id="rewardImage-0" accept=".png,.jpg,.jpeg" style="display: none;" onchange="handleRewardImageUpload(this, '0')">
                                                    <div class="backstage-file-placeholder" id="placeholder-0">
                                                        <span class="backstage-file-icon">📷</span>
                                                        <span class="backstage-file-text">點擊上傳獎勵圖片</span>
                                                        <small>支援 PNG、JPG、JPEG 格式</small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                </div>
                <% } %>
            </div>
                                <div class="backstage-form-actions">
                                    <button type="button" class="backstage-btn backstage-btn-outline" onclick="addReward()">新增獎勵項目</button>
                                    <button type="submit" class="backstage-btn backstage-btn-primary">儲存獎勵設定</button>
                                </div>
                                </form>
                        </div>

                        <!-- 使用規則設定 -->
                        <div class="backstage-setting-card">
                            <h3>使用規則設定</h3>
                            <p class="backstage-card-desc">設定集點卡的使用規則說明，這些規則會顯示在顧客的集點卡頁面上</p>
                            <form id="rulesForm" class="backstage-form">
                                <div id="rules-list" class="backstage-rules-list">
                                    <!-- 動態載入規則列表 -->
                                    <div class="loading-rules">
                                        <p>🔄 正在載入規則設定...</p>
                                    </div>
                                </div>
                                <div class="backstage-form-actions">
                                    <button type="button" class="backstage-btn backstage-btn-outline" onclick="addRule()">新增規則</button>
                                    <button type="submit" class="backstage-btn backstage-btn-primary">儲存規則</button>
                                </div>
                            </form>
                        </div>

                        <!-- 統計數據 -->
                        <div class="backstage-setting-card">
                            <h3>集點卡統計</h3>
                            <p class="backstage-card-desc">查看集點卡系統的使用情況和統計數據</p>
                            <div class="backstage-stats-grid">
                                <div class="backstage-stat-item">
                                    <div class="stat-value">
                                        <span class="loading-stats">🔄</span>
                                        <span class="stat-number" style="display: none;">0</span>
                                    </div>
                                    <div class="stat-label">註冊會員</div>
                                    <div class="stat-desc">擁有集點卡的會員總數</div>
                                </div>
                                <div class="backstage-stat-item">
                                    <div class="stat-value">
                                        <span class="loading-stats">🔄</span>
                                        <span class="stat-number" style="display: none;">0</span>
                                    </div>
                                    <div class="stat-label">活躍會員</div>
                                    <div class="stat-desc">30天內有活動的會員</div>
                                </div>
                                <div class="backstage-stat-item">
                                    <div class="stat-value">
                                        <span class="loading-stats">🔄</span>
                                        <span class="stat-number" style="display: none;">0</span>
                                    </div>
                                    <div class="stat-label">已兌換獎勵</div>
                                    <div class="stat-desc">累計兌換的獎勵數量</div>
                                </div>
                                <div class="backstage-stat-item">
                                    <div class="stat-value">
                                        <span class="loading-stats">🔄</span>
                                        <span class="stat-number" style="display: none;">0</span>
                                    </div>
                                    <div class="stat-label">總發放點數</div>
                                    <div class="stat-desc">系統累計發放的點數</div>
                                </div>
                            </div>
                            <div class="backstage-form-actions" style="margin-top: 20px;">
                                <button type="button" class="backstage-btn backstage-btn-outline" onclick="loadPointsStats()">🔄 重新整理統計</button>
                            </div>
                        </div>
                        <% } else { %>
                        <!-- 集點卡功能未開啟 -->
                        <div class="backstage-setting-card">
                            <h3>集點卡功能未開啟</h3>
                            <div class="backstage-info-box">
                                <p>集點卡功能目前未開啟。請到基本設定中開啟集點卡系統。</p>
                                <button type="button" class="backstage-btn backstage-btn-primary" onclick="navigateToPage('basic')">
                                    前往開啟集點卡功能
                                </button>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>

                <!-- 點數QR碼頁面 -->
                <div class="backstage-page" id="qrcode-page">
                    <div class="backstage-page-header">
                        <button class="backstage-back-btn" onclick="navigateToPage('dashboard')">← 返回</button>
                        <h1>點數QR碼</h1>
                        <p>生成和管理點數發放QR碼</p>
            </div>

                    <div class="backstage-page-content">
                        <% if (customSettings && customSettings.features && customSettings.features.pointsSystem) { %>
                        <!-- QR碼生成器 -->
                        <div class="backstage-setting-card">
                            <h3>生成點數QR碼</h3>
                            <form id="qrcodeGenerateForm" class="backstage-form">
                                <div class="backstage-form-row">
                                    <div class="backstage-form-group">
                                        <label for="qrPoints">點數數量</label>
                                        <input type="number" id="qrPoints" name="points" 
                                               min="1" max="100" value="1" required>
                                        <small>設定此QR碼可兌換的點數（1-100點）</small>
                                    </div>
                                </div>
                                <div class="backstage-form-actions">
                                    <button type="submit" id="generateQRBtn" class="backstage-btn backstage-btn-primary">生成QR碼</button>
                                </div>
                            </form>
                        </div>

                        <!-- 當前QR碼狀態 -->
                        <div class="backstage-setting-card">
                            <h3>當前QR碼狀態</h3>
                            <div id="qrCodeDisplay">
                                <div class="backstage-info-box">
                                    <p>🔄 正在檢查QR碼狀態...</p>
                                </div>
                            </div>
                        </div>

                        <!-- QR碼使用說明 -->
                        <div class="backstage-setting-card">
                            <h3>使用說明</h3>
                            <div class="backstage-info-box">
                                <ul style="text-align: left; padding-left: 20px;">
                                    <li>每次只能有一個活躍的QR碼</li>
                                    <li>QR碼會在5分鐘後自動失效</li>
                                    <li>生成新QR碼會自動刪除舊的未使用QR碼</li>
                                    <li>顧客掃描QR碼後可以直接兌換對應點數</li>
                                    <li>已兌換的QR碼會自動記錄到系統中</li>
                                </ul>
                            </div>
                        </div>
                        <% } else { %>
                        <!-- 集點卡功能未開啟 -->
                        <div class="backstage-setting-card">
                            <h3>集點卡功能未開啟</h3>
                            <div class="backstage-info-box">
                                <p>QR碼功能需要先開啟集點卡系統。請到基本設定中開啟集點卡功能。</p>
                                <button type="button" class="backstage-btn backstage-btn-primary" onclick="navigateToPage('basic')">
                                    前往開啟集點卡功能
                                </button>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 時段編輯彈窗 -->
    <div class="timeslot-modal" id="timeslotModal">
        <div class="timeslot-modal-content">
            <div class="timeslot-modal-header">
                <h3 id="modalTitle">編輯時段</h3>
                <button type="button" class="timeslot-modal-close" onclick="closeTimeslotModal()">×</button>
            </div>
            <form id="timeslotModalForm" class="timeslot-modal-form">
                <input type="hidden" id="modalSlotId" name="slotId">
                <div class="backstage-form-group">
                    <label for="modalTime">時段時間</label>
                    <input type="time" id="modalTime" name="time" required>
                </div>
                <div class="backstage-form-group">
                    <label for="modalMaxBookings">最多訂位組數</label>
                    <input type="number" id="modalMaxBookings" name="maxBookings" 
                           min="1" max="50" required>
                </div>
                <div class="backstage-form-group">
                    <label class="backstage-toggle-label">
                        <input type="checkbox" id="modalAvailable" name="available">
                        <span class="backstage-toggle-slider"></span>
                        <span class="backstage-toggle-text">開放此時段</span>
                    </label>
                </div>
                <div class="timeslot-modal-actions">
                    <button type="button" class="backstage-btn backstage-btn-secondary" onclick="closeTimeslotModal()">取消</button>
                    <button type="submit" class="backstage-btn backstage-btn-primary">儲存</button>
                </div>
            </form>
        </div>
    </div>

    <!-- 後台 Footer -->
    <footer class="backstage-main-footer">
        <div class="backstage-main-footer-content">
            <p class="footer-copyright">© 2025 ZYW. All rights reserved.</p>
</div>
    </footer>

    <script src="/js/backstage-spa.js"></script>
</body>
</html>