<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>帳號中心</title>
    <link rel="stylesheet" href="/css/account.css">
    <link rel="stylesheet" href="/css/main_nav_bar.css">
</head>
<body>
    <% if (typeof customNavbar !== 'undefined') { %>
        <%- customNavbar %>
    <% } else { %>
        <%- include('../partials/header') %>
    <% } %>
    <div class="account-wrapper">
        <%- include('../partials/account_sidebar', { user: user }) %>
        <main class="account-main">
            <%- body %>
        </main>
    </div>
</body>
</html>
