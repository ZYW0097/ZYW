<aside class="account-sidebar">
    <!-- 桌面版sidebar -->
    <div class="sidebar-desktop desktop-only">
        <div class="sidebar-profile">
            <img src="<%= user.avatar || '/images/user_icon.svg' %>" class="sidebar-avatar" alt="user">
            <div class="sidebar-name"><%= user.name || '用戶名稱' %></div>
        </div>
        <div class="sidebar-divider"></div>
        <nav class="sidebar-nav">
            <a href="/account/points" class="sidebar-link"><img src="/images/points_card.svg" class="icon">集點卡&nbsp;</a>
            <a href="/account/profile" class="sidebar-link"><img src="/images/user.svg" class="icon">  基本資料</a>
            <a href="/account/settings" class="sidebar-link"><img src="/images/setting.svg" class="icon"> 帳號設定</a>
        </nav>
        <a href="/auth/logout" class="sidebar-logout">登出</a>
    </div>
    
    <!-- 手機版header -->
    <div class="sidebar-mobile mobile-only">
        <div class="mobile-sidebar-header">
            <div class="mobile-profile">
                <img src="<%= user.avatar || '/images/user_icon.svg' %>" class="mobile-avatar" alt="user">
                <div class="mobile-name"><%= user.name || '用戶名稱' %></div>
            </div>
            <button class="account-hamburger" id="account-hamburger-btn" aria-label="menu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
    
    <!-- 統一的手機版選單 -->
    <div class="account-mobile-menu" id="account-mobile-menu">
        <div class="account-mobile-header">
            <a class="nav-logo" href="/">DINE✦</a>
        </div>
        
        <!-- 用戶資訊區域 -->
        <div class="account-mobile-user">
            <div class="mobile-user-content">
                <img src="<%= user.avatar || '/images/user_icon.svg' %>" alt="user" class="user-icon">
                <div class="mobile-username"><%= user.name || '用戶名稱' %></div>
            </div>
        </div>
        
        <!-- 帳號功能區域 -->
        <div class="account-menu-section">
            <div class="menu-section-title">帳號管理</div>
            <a href="/account/points" class="account-mobile-link">
                <img src="/images/points_card.svg" class="link-icon">
                <span>集點卡</span>
            </a>
            <a href="/account/profile" class="account-mobile-link">
                <img src="/images/user.svg" class="link-icon">
                <span>基本資料</span>
            </a>
            <a href="/account/settings" class="account-mobile-link">
                <img src="/images/setting.svg" class="link-icon">
                <span>帳號設定</span>
            </a>
        </div>
        
        <!-- 導航功能區域 -->
        <div class="account-menu-section">
            <div class="menu-section-title">網站導航</div>
            <a class="account-mobile-link" href="/">
                <span>餐廳首頁</span>
            </a>
            <a class="account-mobile-link" href="/<%= typeof storeSlug !== 'undefined' ? storeSlug : '' %>/card">
                <span>集點卡</span>
            </a>
            <a class="account-mobile-link" href="/<%= typeof storeSlug !== 'undefined' ? storeSlug : '' %>/booking">
                <span>訂位</span>
            </a>
        </div>
        
        <!-- 登出區域 -->
        <div class="account-menu-section">
            <a href="/auth/logout" class="account-mobile-logout">登出</a>
        </div>
    </div>
    <div class="account-mobile-overlay" id="account-mobile-overlay"></div>
</aside>