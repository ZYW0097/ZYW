<% var customCss = '/css/account_settings.css'; %>
<% var customJs = '/js/account_settings.js'; %>
<div class="dashboard-container">
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="error-message">
            <%= error %>
        </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="success-message">
            <%= success %>
        </div>
    <% } %>

    <!-- 主要控制面板 -->
    <div class="dashboard-grid">
        <!-- 密碼設定卡片 -->
        <div class="dashboard-card password-card">
            <div class="card-header">
                <div class="card-icon">🔒</div>
                <div class="card-info">
                    <h3 class="card-title">
                        <% if (user.hasPassword) { %>
                            修改密碼
                        <% } else { %>
                            設定密碼
                        <% } %>
                    </h3>
                    <p class="card-description">
                        <% if (user.hasPassword) { %>
                            變更您的登入密碼，確保帳號安全
                        <% } else { %>
                            設定密碼後，您可以使用手機號碼和密碼登入
                        <% } %>
                    </p>
                </div>
                <% if (user.hasPassword) { %>
                    <button type="button" class="edit-password-btn" id="editPasswordBtn">編輯</button>
                <% } %>
            </div>

            <form class="card-form" action="/account/settings/password" method="POST" id="passwordForm">
                <% if (user.hasPassword) { %>
                    <div class="form-group">
                        <label class="form-label" for="currentPassword">目前密碼</label>
                        <input 
                            type="password" 
                            id="currentPassword" 
                            name="currentPassword" 
                            class="form-input" 
                            placeholder="請輸入目前的密碼"
                            required
                            disabled
                        >
                    </div>
                <% } %>

                <div class="form-group">
                    <label class="form-label" for="newPassword">
                        <%= user.hasPassword ? '新密碼' : '密碼' %>
                    </label>
                    <input 
                        type="password" 
                        id="newPassword" 
                        name="newPassword" 
                        class="form-input" 
                        placeholder="請輸入新密碼（至少8字元）"
                        required
                        <% if (user.hasPassword) { %>disabled<% } %>
                    >
                    <div class="password-strength" id="passwordStrength" style="display: none;">
                        <div class="strength-bar">
                            <div class="strength-fill"></div>
                        </div>
                        <div class="strength-text"></div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="confirmPassword">確認密碼</label>
                    <input 
                        type="password" 
                        id="confirmPassword" 
                        name="confirmPassword" 
                        class="form-input" 
                        placeholder="請再次輸入密碼"
                        required
                        <% if (user.hasPassword) { %>disabled<% } %>
                    >
                </div>

                <div class="password-actions">
                    <button type="submit" class="card-btn card-btn-primary" id="passwordBtn" <% if (user.hasPassword) { %>style="display: none;"<% } %>>
                        <%= user.hasPassword ? '更新密碼' : '設定密碼' %>
                    </button>
                    <% if (user.hasPassword) { %>
                        <button type="button" class="card-btn card-btn-secondary" id="cancelPasswordBtn" style="display: none;">取消</button>
                    <% } %>
                </div>
            </form>
        </div>

        <!-- 登入資訊卡片 -->
        <div class="dashboard-card info-card">
            <div class="card-header">
                <div class="card-icon">📱</div>
                <div class="card-info">
                    <h3 class="card-title">登入資訊</h3>
                    <p class="card-description">管理您的登入方式和帳號狀態</p>
                </div>
            </div>

            <div class="info-grid">
                <div class="info-item">
                    <div class="info-row">
                        <span class="info-label">LINE 帳號</span>
                        <div class="info-status-group">
                            <span class="info-value">已綁定</span>
                            <span class="info-status status-connected">✓</span>
                        </div>
                    </div>
                </div>
                
                <div class="info-item">
                    <div class="info-row">
                        <span class="info-label">手機號碼</span>
                        <div class="info-status-group">
                            <span class="info-value">
                                <%= user.phone || '尚未設定' %>
                            </span>
                            <span class="info-status <%= user.phone ? 'status-connected' : 'status-disconnected' %>">
                                <%= user.phone ? '✓' : '!' %>
                            </span>
                        </div>
                    </div>
                </div>
                
                <div class="info-item">
                    <div class="info-row">
                        <span class="info-label">密碼登入</span>
                        <div class="info-status-group">
                            <span class="info-value">
                                <%= user.hasPassword ? '已設定' : '尚未設定' %>
                            </span>
                            <span class="info-status <%= user.hasPassword ? 'status-connected' : 'status-disconnected' %>">
                                <%= user.hasPassword ? '✓' : '!' %>
                            </span>
                        </div>
                    </div>
                </div>
                
                <div class="info-item">
                    <div class="info-row">
                        <span class="info-label">最後登入</span>
                        <div class="info-status-group">
                            <span class="info-value">
                                <%= user.lastLogin ? new Date(user.lastLogin).toLocaleString('zh-TW') : '無記錄' %>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 安全設定卡片 -->
        <div class="dashboard-card security-card">
            <div class="card-blur-overlay">即將推出</div>
            <div class="card-header">
                <div class="card-icon">⚡</div>
                <div class="card-info">
                    <h3 class="card-title">安全設定</h3>
                    <p class="card-description">管理您的帳號安全功能</p>
                </div>
            </div>

            <div class="security-options">
                <div class="security-item">
                    <div class="security-info">
                        <span class="security-label">雙重驗證</span>
                        <span class="security-desc">增強帳號安全性</span>
                    </div>
                    <div class="security-toggle">
                        <label class="toggle-switch">
                            <input type="checkbox" disabled>
                            <span class="toggle-slider"></span>
                        </label>
                        <span class="coming-soon">即將推出</span>
                    </div>
                </div>

                <div class="security-item">
                    <div class="security-info">
                        <span class="security-label">登入通知</span>
                        <span class="security-desc">新裝置登入時通知</span>
                    </div>
                    <div class="security-toggle">
                        <label class="toggle-switch">
                            <input type="checkbox" checked disabled>
                            <span class="toggle-slider"></span>
                        </label>
                        <span class="security-status">已啟用</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 危險操作卡片 -->
        <div class="dashboard-card danger-card">
            <div class="card-header">
                <div class="card-icon">⚠️</div>
                <div class="card-info">
                    <h3 class="card-title">危險操作</h3>
                    <p class="card-description">這些操作無法復原，請謹慎使用</p>
                </div>
            </div>
            
            <div class="danger-actions">
                <% if (user.hasPassword) { %>
                    <button type="button" class="card-btn card-btn-danger" onclick="removePassword()">
                        <span class="btn-icon">🔓</span>
                        移除密碼登入
                    </button>
                <% } %>
                <button type="button" class="card-btn card-btn-danger" onclick="deleteAccount()">
                    <span class="btn-icon">🗑️</span>
                    刪除帳號
                </button>
            </div>
        </div>
    </div>
</div>