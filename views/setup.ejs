<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>系統設定 - DINE✦</title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/setup.css">
</head>
<body>
    <div class="setup-wrapper">
        <div class="setup-container">
            <!-- 步驟導航 -->
            <div class="steps-header">
                <div class="steps-nav">
                    <div class="step-item active" id="step-nav-1">
                        <div class="step-circle">1</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step-item" id="step-nav-2">
                        <div class="step-circle">2</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step-item" id="step-nav-3">
                        <div class="step-circle">2-1</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step-item" id="step-nav-4">
                        <div class="step-circle">2-2</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step-item" id="step-nav-5">
                        <div class="step-circle">3</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step-item" id="step-nav-6">
                        <div class="step-circle">4</div>
                    </div>
                </div>
                <div class="step-title" id="step-title">基本資料設定</div>
            </div>

            <!-- 錯誤訊息 -->
            <div id="errorMessage" class="error-message"></div>

            <!-- 表單 -->
            <form id="setupForm" class="form-container" enctype="multipart/form-data">
                <!-- 步驟 1: 基本資料 -->
                <div class="form-step active" id="step-1">
                    <div class="step-content">
                        <h2>基本資料設定</h2>
                        <p>請輸入您的餐廳基本資訊和教學預覽圖片</p>

                        <div class="form-group">
                            <label for="clientname">客戶名稱 (最多30字) <span class="required">*</span></label>
                            <input type="text" id="clientname" name="clientname" required maxlength="30" placeholder="請輸入客戶名稱">
                            <div class="validation-message" id="clientname-validation"></div>
                        </div>

                        <div class="form-group">
                            <label for="slugname">動態標識 (僅限英文或數字，最多30字) <span class="required">*</span></label>
                            <input type="text" id="slugname" name="slugname" required pattern="[a-zA-Z0-9]+" maxlength="30" placeholder="請輸入系統識別碼">
                            <div class="validation-message" id="slugname-validation"></div>
                            
                            <div class="url-preview-container">
                                <div class="url-preview-box">
                                    <span class="url-lock-icon">🔒</span>
                                    <span class="url-preview-text" id="restaurant-url-preview">https://zyw.onrender.com/slug</span>
                                </div>
                                <div class="url-preview-caption">您的客戶將通過此網址訪問餐廳頁面</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 步驟 2: 功能選擇 -->
                <div class="form-step" id="step-2">
                    <div class="step-content">
                        <h2>功能選擇</h2>
                        <p>請選擇要啟用的系統功能 (至少選擇一個)</p>

                        <div class="feature-options">
                            <div class="feature-card selected" id="booking-card" data-feature="booking">
                                <span class="feature-icon">📅</span>
                                <div class="feature-title">訂位系統</div>
                                <div class="feature-desc">客戶可線上預約餐廳座位 (預設開啟)</div>
                            </div>
                            <div class="feature-card" id="points-card" data-feature="points">
                                <span class="feature-icon">🎯</span>
                                <div class="feature-title">集點卡系統</div>
                                <div class="feature-desc">客戶可累積消費點數換取優惠</div>
                            </div>
                        </div>

                        <input type="hidden" name="bookingSystem" id="bookingSystem" value="true">
                        <input type="hidden" name="pointsSystem" id="pointsSystem" value="false">
                    </div>
                </div>

                <!-- 步驟 2A: 訂位系統設定 -->
                <div class="form-step" id="step-2a">
                    <div class="step-content">
                        <h2>訂位系統設定</h2>
                        <p>設定訂位系統的基本資訊和規則</p>

                        <div class="form-group">
                            <label for="restaurantImage">餐廳圖片 <span class="required">*</span></label>
                            <input type="file" id="restaurantImage" name="restaurantImage" accept=".png,.jpg,.jpeg,.svg" onchange="previewImage(this, 'restaurant-preview')">
                            <img id="restaurant-preview" class="preview-image" style="display:none; margin-top: 1rem; max-height: 200px;">
                        </div>

                        <div class="form-group">
                            <label for="restaurantAddress">餐廳地址 <span class="required">*</span></label>
                            <input type="text" id="restaurantAddress" name="restaurantAddress" required placeholder="請輸入餐廳完整地址">
                        </div>

                        <div class="form-group">
                            <label>訂位時段 (24小時制，單一時間) <span class="required">*</span></label>
                            <div class="dynamic-list" id="timeSlots-list">
                                <div class="list-item">
                                    <input type="text" name="timeSlots[]" placeholder="例如: 12:00" required pattern="^([01]?[0-9]|2[0-3]):[0-5][0-9]$">
                                    <button type="button" class="list-btn add-btn" onclick="addTimeSlot()">+</button>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>訂位規則 <span class="required">*</span></label>
                            <div class="dynamic-list" id="diningRules-list">
                                <div class="list-item">
                                    <input type="text" name="diningRules[]" placeholder="請輸入訂位規則" required>
                                    <button type="button" class="list-btn add-btn" onclick="addDiningRule()">+</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 步驟 2B: 集點卡系統設定 -->
                <div class="form-step" id="step-2b">
                    <div class="step-content">
                        <h2>集點卡系統設定</h2>
                        <p>設定集點卡的外觀和獎勵機制</p>

                        <div class="form-group">
                            <label for="cardBackgroundImage">集點卡背景圖 <span class="required">*</span></label>
                            <input type="file" id="cardBackgroundImage" name="cardBackgroundImage" accept=".png,.jpg,.jpeg,.svg" onchange="previewImage(this, 'card-preview')">
                            <img id="card-preview" class="preview-image" style="display:none; margin-top: 1rem; max-height: 200px;">
                        </div>

                        <div class="form-group">
                            <label>集點卡獎勵設定 (至少設定一組) <span class="required">*</span></label>
                            <div class="dynamic-list" id="rewards-list">
                                <div class="list-item reward-item">
                                    <input type="text" name="rewardNames[]" placeholder="獎勵名稱" required>
                                    <input type="number" name="rewardPoints[]" placeholder="所需點數" required min="1">
                                    <input type="file" name="rewardImages[]" accept=".png,.jpg,.jpeg">
                                    <div class="reward-buttons">
                                        <button type="button" class="list-btn add-btn" onclick="addReward()">+</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>集點卡規則 (至少設定一條) <span class="required">*</span></label>
                            <div class="dynamic-list" id="pointRules-list">
                                <div class="list-item">
                                    <input type="text" name="pointRules[]" placeholder="請輸入集點卡規則" required>
                                    <button type="button" class="list-btn add-btn" onclick="addPointRule()">+</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 步驟 3: 後台密碼設定 -->
                <div class="form-step" id="step-3">
                    <div class="step-content">
                        <h2>後台密碼設定</h2>
                        <p>設定管理後台的登入密碼</p>

                        <div class="form-group">
                            <label for="adminPassword">管理員密碼 <span class="required">*</span></label>
                            <input type="password" id="adminPassword" name="adminPassword" required>
                            <div class="password-requirements">
                                <h4>密碼要求：</h4>
                                <ul>
                                    <li>至少8個字元</li>
                                    <li>包含大寫字母</li>
                                    <li>包含小寫字母</li>
                                    <li>包含數字</li>
                                    <li>包含一個特殊字元 (!@#$%^&*)</li>
                                </ul>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="confirmPassword">確認密碼 <span class="required">*</span></label>
                            <input type="password" id="confirmPassword" required>
                        </div>

                        <div class="backend-url">
                            <strong>後台管理網址：</strong><br>
                            <span id="backendUrlPreview">https://zyw.onrender.com/{slugname}/backstage-login</span>
                        </div>
                    </div>
                </div>

                <!-- 步驟 4: 完成設定 -->
                <div class="form-step" id="step-4">
                    <div class="step-content completion-content">
                        <div class="completion-icon">🎉</div>
                        <h2>設定完成！</h2>
                        <p>所有設定已完成，點擊「建立系統」開始建立您的餐廳管理系統。</p>
                    </div>
                </div>

                <!-- 按鈕群組 -->
                <div class="btn-group">
                    <button type="button" class="btn btn-secondary" id="prevBtn" onclick="previousStep()" style="display: none;">
                        ← 上一步
                    </button>
                    <button type="button" class="btn btn-primary" id="nextBtn" onclick="nextStep()">
                        下一步 →
                    </button>
                    <button type="submit" class="btn btn-primary" id="submitBtn" style="display: none;">
                        建立系統
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/setup.js"></script>
</body>
</html> 