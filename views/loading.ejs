<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <title>系統建立中 - DINE✦</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/loading.css">


</head>
<body>
    <div class="loading-wrapper">
        <div class="loading-container">
            <!-- 載入狀態 -->
            <div class="loading-content" id="loadingContent">
                <div class="loading-icon">
                    <div class="loading-spinner"></div>
                </div>
                
                <h1 class="loading-title">正在建立您的系統</h1>
                <p class="loading-subtitle">請稍候，我們正在為您配置專屬的餐廳管理系統...</p>
                
                <!-- 進度條 -->
                <div class="progress-container">
                    <div class="progress-bar">
                        <div class="progress-fill" id="progressFill"></div>
                    </div>
                    <div class="progress-text" id="progressText">0% 完成</div>
                </div>
                
                <!-- 步驟顯示 -->
                <div class="steps-display">
                    <div class="step-item" id="step-1">
                        <div class="step-number">1</div>
                        <div class="step-info">
                            <div class="step-title">建立資料庫記錄</div>
                            <div class="step-description">正在為您的餐廳建立專屬的資料庫...</div>
                        </div>
                    </div>
                    <div class="step-item" id="step-2">
                        <div class="step-number">2</div>
                        <div class="step-info">
                            <div class="step-title">處理圖片資源</div>
                            <div class="step-description">正在上傳和優化您的餐廳圖片...</div>
                        </div>
                    </div>
                    <div class="step-item" id="step-3">
                        <div class="step-number">3</div>
                        <div class="step-info">
                            <div class="step-title">配置系統功能</div>
                            <div class="step-description">正在設定訂位和集點卡功能...</div>
                        </div>
                    </div>
                    <div class="step-item" id="step-4">
                        <div class="step-number">4</div>
                        <div class="step-info">
                            <div class="step-title">生成管理界面</div>
                            <div class="step-description">正在建立您的專屬管理後台...</div>
                        </div>
                    </div>
                    <div class="step-item" id="step-5">
                        <div class="step-number">5</div>
                        <div class="step-info">
                            <div class="step-title">系統初始化完成</div>
                            <div class="step-description">正在進行最後的系統檢查和初始化...</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 成功頁面 -->
            <div class="success-content" id="successContent">
                <div class="success-icon">
                    <span class="checkmark">✓</span>
                </div>
                
                <h1 class="success-title">系統建立成功！</h1>
                <p class="success-message">恭喜！您的餐廳管理系統已經成功建立並準備就緒。</p>
                
                <!-- 系統資訊 -->
                <div class="system-info">
                    <div class="info-row">
                        <div class="info-label">餐廳名稱</div>
                        <div class="info-value" id="clientName">-</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">系統識別碼</div>
                        <div class="info-value" id="slugName">-</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">前台網址</div>
                        <div class="info-value" id="frontendUrl">-</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">後台管理</div>
                        <div class="info-value" id="backendUrl">-</div>
                    </div>
                </div>
                
                <!-- 行動按鈕 -->
                <div class="action-buttons">
                    <a href="#" class="btn btn-secondary" id="visitRestaurantBtn">
                        🏪 查看餐廳頁面
                    </a>
                    <a href="#" class="btn btn-primary" id="visitBackstageBtn">
                        ⚙️ 進入管理後台
                    </a>
                </div>
            </div>

            <!-- 錯誤頁面 -->
            <div class="error-content" id="errorContent">
                <div class="error-icon">⚠</div>
                
                <h1 class="error-title">系統建立失敗</h1>
                <p class="error-message">很抱歉，在建立系統的過程中發生了錯誤。</p>
                
                <div class="error-details" id="errorDetails">
                    錯誤詳情將在這裡顯示...
                </div>
                
                <div class="action-buttons">
                    <a href="/setup" class="btn btn-secondary">返回設定頁面</a>
                    <a href="#" class="btn btn-primary" onclick="location.reload()">重新載入</a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/loading.js"></script>
</body>
</html> 