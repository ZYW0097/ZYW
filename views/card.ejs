<% if (!settings || settings.state !== 'enable') { %>
  <div class="no-card-section">
    <div class="no-card-content">
      <h2>此商家尚未開啟集點卡</h2>
      <p>請稍後再試或聯絡商家。</p>
    </div>
  </div>
<% } else { %>
  <% if (!req.user) { %>
    <!-- 未登入時的顯示 -->
    <div class="login-prompt-section">
      <div class="login-prompt-content">
        <h2>登入帳號，即可開始集點！</h2>
        <p>立即登入您的帳號，開始累積點數兌換獎勵！</p>
        <a href="/account/login?redirect=/<%= storeSlug %>/card" class="login-btn">使用 LINE 登入</a>
      </div>
    </div>
  <% } else if (!userPoints) { %>
    <!-- 已登入但未領取集點卡時的顯示 -->
    <div class="claim-card-section">
      <div class="claim-card-content">
        <h2>領取您的集點卡</h2>
        <p>立即領取集點卡，開始累積點數兌換獎勵！</p>
        <button id="claimCardBtn" class="claim-btn">領取集點卡</button>
      </div>
    </div>
  <% } else { %>
    <!-- 已領取集點卡時的全新設計畫面 -->
    <div class="card-bg">
      <!-- 頂部資訊顯示 -->
      <div class="card-header">
        <div class="card-header-img">
          <img src="/images/dine.jpg" alt="背景圖">
        </div>
        
        <!-- 用戶摘要區域 -->
        <div class="user-summary">
          <div class="user-points">
            <div class="points-value"><%= userPoints['ah-points'] %></div>
            <div class="points-label">點數</div>
          </div>
          
          <div class="user-avatar">
            <% if (user && user.avatar) { %>
              <img src="<%= user.avatar %>" alt="avatar" />
            <% } else { %>
              <div class="avatar-placeholder"><i class="fa fa-user"></i></div>
            <% } %>
            <span class="user-name"><%= user ? user.name : '用戶名稱' %></span>
          </div>
          
          <div class="user-coupons">
            <div class="coupons-value">
              <%= userPoints['ah-coupon-id'] ? userPoints['ah-coupon-id'].reduce((sum, c) => sum + (c.count || 0), 0) : 0 %>
            </div>
            <div class="coupons-label">優惠券</div>
          </div>
        </div>
      </div>
      
      <!-- 內容區域 -->
      <div class="card-content">
        <!-- 選項卡切換區 -->
        <div class="tabs-container">
          <div class="tab active" id="pointsTab">積分規則</div>
          <div class="tab" id="couponsTab">我的優惠券</div>
        </div>
        
        <!-- 點數/獎勵區域 -->
        <div id="pointsContent">
          <div class="rules-section">
            <div class="rules-title">使用規則</div>
            <ul>
              <% (rules || []).forEach(rule => { %>
                <li><%= rule.text %></li>
              <% }) %>
            </ul>
          </div>
          <div class="rewards-section">
            <div class="rewards-title">獎勵兌換</div>
            <% (rewards || []).forEach(reward => { %>
              <div class="reward-row">
                <img class="reward-img" src="<%= reward.img %>" alt="<%= reward.name %>">
                <div class="reward-name"><%= reward.name %></div>
                <button class="reward-points redeem-btn" data-reward-id="<%= reward._id %>"><%= reward.points %>點</button>
              </div>
            <% }) %>
          </div>
        </div>
        
        <!-- 優惠券區域 -->
        <div id="couponsContent" style="display: none;">
          <div class="coupons-section">
            <div class="coupons-title">我的優惠券</div>
            <div class="coupons-container" id="couponsContainer">
              <div class="loading-coupons">載入中...</div>
            </div>
            <div class="empty-coupons-message" style="display: none;">
              <div class="empty-icon">🎁</div>
              <h3>尚無優惠券</h3>
              <p>累積點數並兌換獎勵以獲得優惠券</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% } %>
<% } %>

<!-- Loading Overlay -->
<div id="loadingOverlay" class="loading-overlay" style="display: none;">
    <div class="loading-content">
        <div class="loading-spinner"></div>
        <p class="loading-text">處理中...</p>
    </div>
</div>

<!-- 領取集點卡成功訊息 -->
<div id="claimSuccessMessage" class="success-message" style="display: none;">
    <div class="success-content">
        <div class="success-icon">✓</div>
        <h3>領取成功！</h3>
        <p>您的集點卡已準備就緒</p>
    </div>
</div>

<!-- 兌換獎勵成功訊息 -->
<div id="redeemSuccessMessage" class="success-message" style="display: none;">
    <div class="success-content">
        <div class="success-icon">✓</div>
        <h3>兌換成功！</h3>
        <p>您的優惠券已準備就緒</p>
    </div>
</div>

<% if (typeof error !== 'undefined') { %>
    <div class="error-message">
        <%= error %>
    </div>
<% } %>

<link rel="stylesheet" href="/css/card.css">
<script src="/js/card.js"></script>
