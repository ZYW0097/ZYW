{
	"type": "bubble",
	"size": "mega",
	"hero": {
		"type": "image",
		"url": "https://developers-resource.landpress.line.me/fx/img/01_1_cafe.png",
		"aspectRatio": "20:13",
		"aspectMode": "cover",
		"size": "full"
	},
	"body": {
		"type": "box",
		"layout": "vertical",
		"contents": [
			{
				"type": "text",
				"text": "訂位取消",
				"size": "xxl",
				"align": "center",
				"weight": "bold",
				"color": "#FF6B6B"
			},
			{
				"type": "text",
				"weight": "bold",
				"size": "lg",
				"text": "${storeName}",
				"align": "center",
				"margin": "sm"
			},
			{
				"type": "text",
				"weight": "bold",
				"size": "lg",
				"text": "${bookingDate} ${timeSlot}",
				"align": "center",
				"margin": "sm",
				"color": "#FF6B6B"
			},
			{
				"type": "text",
				"text": "您的訂位已成功取消",
				"align": "center",
				"margin": "lg",
				"color": "#666666",
				"wrap": true
			},
			{
				"type": "box",
				"layout": "vertical",
				"margin": "lg",
				"spacing": "sm",
				"contents": [
					{
						"type": "box",
						"layout": "baseline",
						"spacing": "sm",
						"contents": [
							{
								"type": "text",
								"text": "訂位人",
								"color": "#5F5F5F",
								"size": "sm",
								"flex": 2,
								"margin": "sm"
							},
							{
								"type": "text",
								"text": "${customerName}",
								"wrap": true,
								"color": "#000000",
								"size": "sm",
								"flex": 5,
								"weight": "bold"
							}
						]
					},
					{
						"type": "separator",
						"margin": "sm"
					},
					{
						"type": "box",
						"layout": "baseline",
						"spacing": "sm",
						"contents": [
							{
								"type": "text",
								"text": "訂位編號",
								"color": "#5F5F5F",
								"size": "sm",
								"flex": 2,
								"margin": "sm"
							},
							{
								"type": "text",
								"text": "${bookingId}",
								"wrap": true,
								"color": "#FF6B6B",
								"size": "sm",
								"flex": 5,
								"weight": "bold"
							}
						]
					}
				]
			},
			{
				"type": "text",
				"text": "如有任何問題請聯繫我們",
				"align": "center",
				"margin": "lg",
				"color": "#666666",
				"wrap": true
			}
		]
	}
} 