{
    "type": "bubble",
    "header": {
        "type": "box",
        "layout": "vertical",
        "contents": [
            {
                "type": "box",
                "layout": "horizontal",
                "contents": [
                    {
                        "type": "text",
                        "text": "訂位提醒",
                        "color": "#ffffff",
                        "align": "center",
                        "gravity": "center",
                        "size": "lg",
                        "flex": 4,
                        "weight": "bold"
                    }
                ],
                "alignItems": "center"
            }
        ],
        "backgroundColor": "#FF6B35",
        "paddingAll": "20px"
    },
    "body": {
        "type": "box",
        "layout": "vertical",
        "contents": [
            {
                "type": "text",
                "text": "${storeName}",
                "weight": "bold",
                "size": "md",
                "wrap": true,
                "align": "center",
                "color": "#2E4A62"
            },
            {
                "type": "text",
                "text": "${bookingDate} ${timeSlot}",
                "weight": "bold",
                "size": "md",
                "wrap": true,
                "align": "center",
                "color": "#FF6B35",
                "margin": "sm"
            },
            {
                "type": "text",
                "text": "您的訂位時間即將到來！",
                "align": "center",
                "margin": "lg",
                "color": "#666666",
                "wrap": true
            },
            {
                "type": "box",
                "layout": "vertical",
                "margin": "lg",
                "spacing": "sm",
                "contents": [
                    {
                        "type": "box",
                        "layout": "horizontal",
                        "contents": [
                            {
                                "type": "text",
                                "text": "訂位人",
                                "size": "sm",
                                "color": "#555555",
                                "flex": 2
                            },
                            {
                                "type": "text",
                                "text": "${customerName}",
                                "size": "sm",
                                "color": "#111111",
                                "flex": 5,
                                "weight": "bold"
                            }
                        ]
                    },
                    {
                        "type": "box",
                        "layout": "horizontal",
                        "contents": [
                            {
                                "type": "text",
                                "text": "用餐人數",
                                "size": "sm",
                                "color": "#555555",
                                "flex": 2
                            },
                            {
                                "type": "text",
                                "text": "${partySize}",
                                "size": "sm",
                                "color": "#111111",
                                "flex": 5,
                                "weight": "bold"
                            }
                        ],
                        "margin": "md"
                    },
                    {
                        "type": "box",
                        "layout": "horizontal",
                        "contents": [
                            {
                                "type": "text",
                                "text": "訂位編號",
                                "size": "sm",
                                "color": "#555555",
                                "flex": 2
                            },
                            {
                                "type": "text",
                                "text": "${bookingId}",
                                "size": "sm",
                                "color": "#FF6B35",
                                "flex": 5,
                                "weight": "bold"
                            }
                        ],
                        "margin": "md"
                    }
                ]
            },
            {
                "type": "text",
                "text": "請準時前來用餐，期待您的光臨！",
                "align": "center",
                "margin": "lg",
                "color": "#666666",
                "wrap": true
            }
        ],
        "paddingAll": "20px"
    }
} 