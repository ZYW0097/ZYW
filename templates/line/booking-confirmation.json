{
	"type": "bubble",
	"body": {
		"type": "box",
		"layout": "vertical",
		"contents": [
			{
				"type": "text",
				"text": "訂位成功通知",
				"weight": "bold",
				"size": "xl",
				"color": "#1DB446"
			},
			{
				"type": "text",
				"text": "${storeName}",
				"weight": "bold",
				"size": "lg",
				"margin": "md"
			},
			{
				"type": "text",
				"text": "${date} ${time}",
				"size": "md",
				"color": "#666666",
				"margin": "sm"
			},
			{
				"type": "separator",
				"margin": "lg"
			},
			{
				"type": "box",
				"layout": "vertical",
				"margin": "lg",
				"spacing": "sm",
				"contents": [
					{
						"type": "box",
						"layout": "baseline",
						"spacing": "sm",
						"contents": [
							{
								"type": "text",
								"text": "姓名",
								"color": "#aaaaaa",
								"size": "sm",
								"flex": 1
							},
							{
								"type": "text",
								"text": "${customerName}",
								"wrap": true,
								"color": "#666666",
								"size": "sm",
								"flex": 2
							}
						]
					},
					{
						"type": "box",
						"layout": "baseline",
						"spacing": "sm",
						"contents": [
							{
								"type": "text",
								"text": "電話",
								"color": "#aaaaaa",
								"size": "sm",
								"flex": 1
							},
							{
								"type": "text",
								"text": "${phone}",
								"wrap": true,
								"color": "#666666",
								"size": "sm",
								"flex": 2
							}
						]
					},
					{
						"type": "box",
						"layout": "baseline",
						"spacing": "sm",
						"contents": [
							{
								"type": "text",
								"text": "人數",
								"color": "#aaaaaa",
								"size": "sm",
								"flex": 1
							},
							{
								"type": "text",
								"text": "${partySize}人",
								"wrap": true,
								"color": "#666666",
								"size": "sm",
								"flex": 2
							}
						]
					}
				]
			}
		]
	},
	"footer": {
		"type": "box",
		"layout": "vertical",
		"spacing": "sm",
		"contents": [
			{
				"type": "text",
				"text": "${bookingId}",
				"color": "#ffffff",
				"align": "center",
				"size": "sm",
				"weight": "bold"
			}
		],
		"backgroundColor": "#1DB446"
	}
}