{
	"type": "bubble",
	"hero": {
	  "type": "box",
	  "layout": "vertical",
	  "contents": [],
	  "backgroundColor": "#8CBF7E",
	  "paddingAll": "6px"
	},
	"body": {
	  "type": "box",
	  "layout": "vertical",
	  "contents": [
		{
		  "type": "text",
		  "text": "訂位成功通知",
		  "weight": "bold",
		  "size": "xxl",
		  "align": "center",
		  "color": "#8CBF7E"
		},
		{
		  "type": "box",
		  "layout": "vertical",
		  "margin": "lg",
		  "spacing": "sm",
		  "contents": [
			{
			  "type": "box",
			  "layout": "baseline",
			  "spacing": "sm",
			  "contents": [
				{
				  "type": "text",
				  "text": "${name} ${gender} 您好，",
				  "wrap": true,
				  "size": "md"
				}
			  ]
			},
			{
			  "type": "box",
			  "layout": "baseline",
			  "spacing": "sm",
			  "contents": [
				{
				  "type": "text",
				  "text": "訂位已為您建立，請於指定時間抵達。",
				  "wrap": true,
				  "size": "md"
				}
			  ]
			}
		  ]
		},
		{
		  "type": "box",
		  "layout": "vertical",
		  "contents": [
			{
			  "type": "text",
			  "text": "${storeName}",
			  "wrap": true,
			  "align": "center",
			  "size": "xl",
			  "weight": "bold"
			}
		  ]
		},
		{
		  "type": "separator",
		  "margin": "md"
		},
		{
		  "type": "box",
		  "layout": "baseline",
		  "contents": [
			{
			  "type": "text",
			  "text": "姓　　名",
			  "flex": 2,
			  "color": "#666666",
			  "size": "sm"
			},
			{
			  "type": "text",
			  "text": "${name}",
			  "flex": 5,
			  "size": "sm",
			  "color": "#000000"
			}
		  ],
		  "margin": "md"
		},
		{
		  "type": "box",
		  "layout": "baseline",
		  "contents": [
			{
			  "type": "text",
			  "text": "電　　話",
			  "flex": 2,
			  "color": "#666666",
			  "size": "sm"
			},
			{
			  "type": "text",
			  "text": "${phone}",
			  "flex": 5,
			  "color": "#000000",
			  "size": "sm"
			}
		  ],
		  "margin": "md"
		},
		{
		  "type": "box",
		  "layout": "baseline",
		  "contents": [
			{
			  "type": "text",
			  "text": "用餐日期",
			  "flex": 2,
			  "color": "#666666",
			  "size": "sm"
			},
			{
			  "type": "text",
			  "text": "${date}",
			  "flex": 5,
			  "color": "#000000",
			  "size": "sm"
			}
		  ],
		  "margin": "md"
		},
		{
		  "type": "box",
		  "layout": "baseline",
		  "contents": [
			{
			  "type": "text",
			  "text": "用餐時間",
			  "flex": 2,
			  "color": "#666666",
			  "size": "sm"
			},
			{
			  "type": "text",
			  "text": "${time}",
			  "flex": 5,
			  "color": "#000000",
			  "size": "sm"
			}
		  ],
		  "margin": "md"
		},
		{
		  "type": "box",
		  "layout": "baseline",
		  "contents": [
			{
			  "type": "text",
			  "text": "用餐人數",
			  "flex": 2,
			  "color": "#666666",
			  "size": "sm"
			},
			{
			  "type": "text",
			  "flex": 5,
			  "text": "${adults}大${children}小",
			  "color": "#000000",
			  "size": "sm"
			}
		  ],
		  "margin": "md"
		},
		{
		  "type": "separator",
		  "margin": "md"
		}
	  ]
	},
	"footer": {
	  "type": "box",
	  "layout": "vertical",
	  "contents": [
		{
		  "type": "text",
		  "text": "${customBookingId}",
		  "align": "center",
		  "size": "xl",
		  "color": "#8CBF7E",
		  "weight": "bold"
		},
		{
		  "type": "box",
		  "layout": "vertical",
		  "contents": [
			{
			  "type": "button",
			  "action": {
				"type": "uri",
				"label": "查看完整資訊",
				"uri": "http://linecorp.com/"
			  },
			  "color": "#FFFFFF",
			  "height": "sm"
			}
		  ],
		  "backgroundColor": "#8CBF7E",
		  "cornerRadius": "md",
		  "margin": "md"
		}
	  ]
	}
  }