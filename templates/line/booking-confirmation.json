{
    "type": "bubble",
    "size": "mega",
    "hero": {
      "type": "image",
      "url": "https://developers-resource.landpress.line.me/fx/img/01_1_cafe.png",
      "aspectRatio": "20:13",
      "aspectMode": "cover",
      "size": "full"
    },
    "body": {
      "type": "box",
      "layout": "vertical",
      "contents": [
        {
          "type": "text",
          "text": "訂位成功通知",
          "size": "xxl",
          "align": "center",
          "weight": "bold",
          "margin": "none",
          "color": "#8CBF7E"
        },
        {
          "type": "text",
          "weight": "bold",
          "size": "lg",
          "text": "{{storeName}}",
          "align": "center",
          "margin": "none"
        },
        {
          "type": "text",
          "weight": "bold",
          "size": "lg",
          "text": "{{bookingDate}} {{timeSlot}}",
          "align": "center",
          "margin": "sm"
        },
        {
          "type": "box",
          "layout": "vertical",
          "margin": "lg",
          "spacing": "sm",
          "contents": [
            {
              "type": "box",
              "layout": "baseline",
              "spacing": "sm",
              "contents": [
                {
                  "type": "text",
                  "text": "姓名",
                  "color": "#5F5F5F",
                  "size": "sm",
                  "flex": 2,
                  "margin": "sm"
                },
                {
                  "type": "text",
                  "text": "{{customerName}}",
                  "wrap": true,
                  "color": "#000000",
                  "size": "sm",
                  "flex": 5
                }
              ]
            },
            {
              "type": "separator",
              "margin": "sm"
            },
            {
              "type": "box",
              "layout": "baseline",
              "spacing": "sm",
              "contents": [
                {
                  "type": "text",
                  "text": "電話",
                  "color": "#5F5F5F",
                  "size": "sm",
                  "flex": 2,
                  "margin": "sm"
                },
                {
                  "type": "text",
                  "text": "{{phone}}",
                  "wrap": true,
                  "color": "#000000",
                  "size": "sm",
                  "flex": 5
                }
              ]
            },
            {
              "type": "separator",
              "margin": "sm"
            },
            {
              "type": "box",
              "layout": "baseline",
              "spacing": "sm",
              "contents": [
                {
                  "type": "text",
                  "text": "電子郵件",
                  "color": "#5F5F5F",
                  "size": "sm",
                  "margin": "sm",
                  "flex": 2
                },
                {
                  "type": "text",
                  "text": "{{email}}",
                  "wrap": true,
                  "color": "#000000",
                  "size": "sm",
                  "flex": 5
                }
              ]
            },
            {
              "type": "separator",
              "margin": "sm"
            },
            {
              "type": "box",
              "layout": "baseline",
              "spacing": "sm",
              "contents": [
                {
                  "type": "text",
                  "text": "用餐人數",
                  "color": "#5F5F5F",
                  "size": "sm",
                  "flex": 2,
                  "margin": "sm"
                },
                {
                  "type": "text",
                  "text": "{{partySize}}",
                  "wrap": true,
                  "color": "#000000",
                  "size": "sm",
                  "flex": 5
                }
              ]
            },
            {
              "type": "separator",
              "margin": "sm"
            },
            {
              "type": "box",
              "layout": "baseline",
              "spacing": "sm",
              "contents": [
                {
                  "type": "text",
                  "text": "素食需求",
                  "color": "#5F5F5F",
                  "size": "sm",
                  "flex": 2,
                  "margin": "sm"
                },
                {
                  "type": "text",
                  "text": "{{vegetarianRequirement}}",
                  "wrap": true,
                  "color": "#000000",
                  "size": "sm",
                  "flex": 5
                }
              ]
            },
            {
              "type": "separator",
              "margin": "sm"
            },
            {
              "type": "box",
              "layout": "baseline",
              "spacing": "sm",
              "contents": [
                {
                  "type": "text",
                  "text": "特殊需求",
                  "color": "#5F5F5F",
                  "size": "sm",
                  "flex": 2,
                  "margin": "sm"
                },
                {
                  "type": "text",
                  "text": "{{specialRequirement}}",
                  "wrap": true,
                  "color": "#000000",
                  "size": "sm",
                  "flex": 5
                }
              ]
            },
            {
              "type": "separator",
              "margin": "sm"
            },
            {
              "type": "box",
              "layout": "baseline",
              "spacing": "sm",
              "contents": [
                {
                  "type": "text",
                  "text": "備註",
                  "color": "#5F5F5F",
                  "size": "sm",
                  "margin": "sm",
                  "flex": 2
                },
                {
                  "type": "text",
                  "text": "{{note}}",
                  "wrap": true,
                  "color": "#000000",
                  "size": "sm",
                  "flex": 5
                }
              ]
            },
            {
              "type": "separator",
              "margin": "sm"
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "box",
      "layout": "vertical",
      "contents": [
        {
          "type": "text",
          "text": "{{bookingId}}",
          "color": "#ffffff",
          "weight": "bold",
          "align": "center",
          "size": "lg",
          "wrap": true
        }
      ],
      "flex": 0,
      "backgroundColor": "#8CBF7E",
      "borderWidth": "medium",
      "width": "100%",
      "height": "65px",
      "alignItems": "center",
      "justifyContent": "center"
    }
  }