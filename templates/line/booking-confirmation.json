{
    "type": "bubble",
    "header": {
        "type": "box",
        "layout": "vertical",
        "contents": [
            {
                "type": "box",
                "layout": "horizontal",
                "contents": [
                    {
                        "type": "text",
                        "text": "訂位成功通知",
                        "color": "#ffffff",
                        "align": "center",
                        "gravity": "center",
                        "size": "lg",
                        "flex": 4,
                        "weight": "bold"
                    }
                ],
                "alignItems": "center"
            }
        ],
        "backgroundColor": "#8CBF7E",
        "paddingAll": "20px"
    },
    "body": {
        "type": "box",
        "layout": "vertical",
        "contents": [
            {
                "type": "text",
                "text": "${storeName}",
                "weight": "bold",
                "size": "md",
                "wrap": true,
                "align": "center",
                "color": "#2E4A62"
            },
            {
                "type": "text",
                "text": "${bookingDate} ${timeSlot}",
                "weight": "bold",
                "size": "md",
                "wrap": true,
                "align": "center",
                "color": "#8CBF7E",
                "margin": "sm"
            },
            {
                "type": "box",
                "layout": "vertical",
                "margin": "lg",
                "spacing": "sm",
                "contents": [
                    {
                        "type": "box",
                        "layout": "horizontal",
                        "contents": [
                            {
                                "type": "text",
                                "text": "姓名",
                                "size": "sm",
                                "color": "#555555",
                                "flex": 2
                            },
                            {
                                "type": "text",
                                "text": "${customerName}",
                                "size": "sm",
                                "color": "#111111",
                                "flex": 5
                            }
                        ]
                    },
                    {
                        "type": "box",
                        "layout": "horizontal",
                        "contents": [
                            {
                                "type": "text",
                                "text": "電話",
                                "size": "sm",
                                "color": "#555555",
                                "flex": 2
                            },
                            {
                                "type": "text",
                                "text": "${phone}",
                                "size": "sm",
                                "color": "#111111",
                                "flex": 5
                            }
                        ],
                        "margin": "md"
                    },
                    {
                        "type": "box",
                        "layout": "horizontal",
                        "contents": [
                            {
                                "type": "text",
                                "text": "電子郵件",
                                "size": "sm",
                                "color": "#555555",
                                "flex": 2
                            },
                            {
                                "type": "text",
                                "text": "${email}",
                                "size": "sm",
                                "color": "#111111",
                                "flex": 5
                            }
                        ],
                        "margin": "md"
                    },
                    {
                        "type": "box",
                        "layout": "horizontal",
                        "contents": [
                            {
                                "type": "text",
                                "text": "用餐人數",
                                "size": "sm",
                                "color": "#555555",
                                "flex": 2
                            },
                            {
                                "type": "text",
                                "text": "${partySize}",
                                "size": "sm",
                                "color": "#111111",
                                "flex": 5
                            }
                        ],
                        "margin": "md"
                    },
                    {
                        "type": "box",
                        "layout": "horizontal",
                        "contents": [
                            {
                                "type": "text",
                                "text": "素食需求",
                                "size": "sm",
                                "color": "#555555",
                                "flex": 2
                            },
                            {
                                "type": "text",
                                "text": "${vegetarianRequirement}",
                                "size": "sm",
                                "color": "#111111",
                                "flex": 5
                            }
                        ],
                        "margin": "md"
                    },
                    {
                        "type": "box",
                        "layout": "horizontal",
                        "contents": [
                            {
                                "type": "text",
                                "text": "特殊需求",
                                "size": "sm",
                                "color": "#555555",
                                "flex": 2
                            },
                            {
                                "type": "text",
                                "text": "${specialRequirement}",
                                "size": "sm",
                                "color": "#111111",
                                "flex": 5
                            }
                        ],
                        "margin": "md"
                    },
                    {
                        "type": "box",
                        "layout": "horizontal",
                        "contents": [
                            {
                                "type": "text",
                                "text": "備註",
                                "size": "sm",
                                "color": "#555555",
                                "flex": 2
                            },
                            {
                                "type": "text",
                                "text": "${note}",
                                "size": "sm",
                                "color": "#111111",
                                "flex": 5
                            }
                        ],
                        "margin": "md"
                    },
                    {
                        "type": "box",
                        "layout": "horizontal",
                        "contents": [
                            {
                                "type": "text",
                                "text": "訂位編號",
                                "size": "sm",
                                "color": "#555555",
                                "flex": 2
                            },
                            {
                                "type": "text",
                                "text": "${bookingId}",
                                "size": "sm",
                                "color": "#8CBF7E",
                                "flex": 5,
                                "weight": "bold"
                            }
                        ],
                        "margin": "md"
                    }
                ]
            }
        ],
        "paddingAll": "20px"
    }
}